{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "tortoise-rights/song/1.0",
  "title": "Tortoise Rights — Song Manifest",
  "description": "Uploaded to Walrus; keccak256 of the exact JSON bytes is recorded on-chain as manifestHash.",
  "type": "object",
  "required": ["schema", "songId", "slug", "title", "artist", "audio", "priceUsdc", "license", "consent", "createdAt"],
  "additionalProperties": true,
  "properties": {
    "schema": { "const": "tortoise-rights/song/1.0" },
    "songId": { "type": "string", "description": "music_metadata.id (UUID)" },
    "slug": { "type": "string" },
    "title": { "type": "string" },
    "artist": {
      "type": "object",
      "required": ["address"],
      "properties": {
        "address": { "type": "string", "pattern": "^0x[a-fA-F0-9]{40}$" },
        "name": { "type": "string" },
        "fid": { "type": "integer" }
      }
    },
    "audio": {
      "type": "object",
      "required": ["keccak256", "mimeType", "bytes", "walrusBlobId"],
      "properties": {
        "keccak256": { "type": "string", "pattern": "^0x[a-fA-F0-9]{64}$" },
        "mimeType": { "type": "string" },
        "bytes": { "type": "integer" },
        "sourceIpfsCid": { "type": "string", "description": "original audio source (provenance)" },
        "walrusBlobId": { "type": "string" }
      }
    },
    "priceUsdc": { "type": "string", "description": "6 decimals, also on-chain" },
    "license": {
      "type": "object",
      "required": ["name", "termsHash", "termsUrl"],
      "properties": {
        "name": { "type": "string" },
        "termsHash": { "type": "string", "pattern": "^0x[a-fA-F0-9]{64}$", "description": "keccak256(LICENSE_TERMS.md)" },
        "termsUrl": { "type": "string" }
      }
    },
    "consent": {
      "type": "object",
      "required": ["optIn", "permissionMode", "permissionModeId", "licenseTermsHash", "timestamp", "signature", "eip712"],
      "properties": {
        "optIn": { "type": "boolean" },
        "permissionMode": { "type": "string" },
        "permissionModeId": { "type": "integer" },
        "licenseTermsHash": { "type": "string", "pattern": "^0x[a-fA-F0-9]{64}$" },
        "timestamp": { "type": "integer" },
        "signature": { "type": "string", "pattern": "^0x[a-fA-F0-9]+$" },
        "eip712": {
          "type": "object",
          "required": ["domain", "primaryType"],
          "properties": {
            "domain": { "type": "object" },
            "primaryType": { "const": "Consent" }
          }
        }
      }
    },
    "createdAt": { "type": "string", "format": "date-time" }
  }
}
