# =============================================================================
# Tortoise Rights Registry — environment template
# Copy to `.env` (gitignored) and fill in. NEVER commit real values.
# =============================================================================

# ----- RPC -----
# Base mainnet (chainId 8453). Public endpoint works; swap for a private one if rate-limited.
NEXT_PUBLIC_RPC_URL=https://mainnet.base.org
BASE_RPC_URL=https://mainnet.base.org
# Ethereum L1 (only needed for ENS resolver setup / reads)
L1_RPC_URL=https://ethereum-rpc.publicnode.com
# Arc testnet (chainId 5042002) — registry + USDC payment chain when REGISTRY_CHAIN_ID=5042002.
ARC_RPC_URL=https://rpc.testnet.arc.network
NEXT_PUBLIC_ARC_RPC_URL=https://rpc.testnet.arc.network

# ----- Registry chain switch -----
# Which chain the rights registry + USDC payment + EIP-712 consent domain live on.
#   8453    = Base mainnet (default; real USDC)
#   5042002 = Arc testnet  (Circle's USDC-native L1; USDC is the gas token — fund from faucet.circle.com)
# ENS subnames ALWAYS stay on Base regardless (Durin can't prove a non-rollup L1). Leave unset for Base.
# Both must match (server + browser): set them together.
REGISTRY_CHAIN_ID=8453
NEXT_PUBLIC_REGISTRY_CHAIN_ID=8453

# ----- Walrus (TESTNET for blobs — see README "Walrus" note) -----
# Mainnet has no free publisher; we use the free open testnet publisher for audio + manifests.
# Reads use the matching testnet aggregator. (Verified working 2026-06.)
WALRUS_PUBLISHER=https://publisher.walrus-testnet.walrus.space
WALRUS_AGGREGATOR=https://aggregator.walrus-testnet.walrus.space
# Optional: auth header value if you switch to an authed/own publisher (e.g. "Bearer xxx"). Leave blank for testnet.
WALRUS_PUBLISHER_AUTH=
# Storage duration in epochs. ⚠️ Blobs are EPHEMERAL: Walrus testnet deletes them once the epochs
# elapse (and testnet is periodically wiped), so independent verification works for a finite window
# (~weeks at this value). We request a large value the public testnet publisher still accepts; if a
# PUT 400s it's over the cap — lower it. Re-run `pnpm smoke:walrus` after changing to confirm.
WALRUS_EPOCHS=53

# ----- Onchain addresses: REGISTRY CHAIN (registry + USDC payment) -----
# Pre-filled with the LIVE Base deployment so `pnpm verify licensetest5` works out of the box from a
# fresh clone. These four follow REGISTRY_CHAIN_ID — when you flip to Arc, replace them with your Arc
# deployment's values (USDC -> the Arc system USDC below; registry -> your Arc-deployed address).
# USDC — VERIFIED decimals()=6 on Base mainnet.
USDC_ADDRESS=0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913
RIGHTS_REGISTRY_ADDRESS=0xA0bd2b9f2d9554cA3AAeD618E420Aac816d80bbe
# ⚠️ The browser can ONLY read NEXT_PUBLIC_* vars. Keep this == RIGHTS_REGISTRY_ADDRESS — the app's
# register + purchase flows read it client-side. Mirror it into Vercel env (Step 5).
NEXT_PUBLIC_RIGHTS_REGISTRY_ADDRESS=0xA0bd2b9f2d9554cA3AAeD618E420Aac816d80bbe
# The block the registry was deployed at — lets verify-song-license.mjs --buyer scan LicensePurchased
# events from there (public RPCs cap eth_getLogs to ~10k blocks). Registry-chain block.
REGISTRY_DEPLOY_BLOCK=47297643
# Treasury that receives USDC license payments (constructor arg, only needed if you DEPLOY — triple-check, C9).
TREASURY_ADDRESS=

# ----- Arc testnet overrides (only when REGISTRY_CHAIN_ID=5042002) -----
# Arc's USDC ERC-20 interface — system contract, decimals()=6 (confirmed on-chain). When on Arc the
# app uses this for the registry-chain USDC; preferred over USDC_ADDRESS so a Base value can't leak.
ARC_USDC_ADDRESS=0x3600000000000000000000000000000000000000
NEXT_PUBLIC_ARC_USDC_ADDRESS=0x3600000000000000000000000000000000000000
# After deploying the registry to Arc, set REGISTRY_CHAIN_ID=5042002 (above) and overwrite
# RIGHTS_REGISTRY_ADDRESS / NEXT_PUBLIC_RIGHTS_REGISTRY_ADDRESS / REGISTRY_DEPLOY_BLOCK with the Arc
# deployment's values. (The Base values above are what you replace, not a separate set of vars.)

# ----- Onchain addresses: ENS on Base (ALWAYS Base — Durin) -----
# The ENS registrar + L2Registry stay on Base mainnet even when the registry+payment are on Arc.
TORTOISE_REGISTRAR_ADDRESS=0x7640eB413A5AD4aa1D28485db09a658629e30601
NEXT_PUBLIC_TORTOISE_REGISTRAR_ADDRESS=0x7640eB413A5AD4aa1D28485db09a658629e30601
L2_REGISTRY_ADDRESS=0x8aB7bB948298826D7495656290dFD241a544A680

# ----- ENS -----
ENS_PARENT=tortmusic.eth
# Durin L1 resolver (Ethereum mainnet) + L2RegistryFactory (Base) — same across chains.
DURIN_L1_RESOLVER=0x8A968aB9eb8C084FBC44c531058Fc9ef945c3D61
DURIN_L2_FACTORY=0xDddddDdDDD8Aa1f237b4fa0669cb46892346d22d
# CCIP-Read gateway hostname reported by the durin.dev deploy flow (fill after L2Registry deploy).
DURIN_CCIP_GATEWAY=

# ----- Tortoise public read seam (D9) -----
TORTOISE_API_BASE=https://tortoise.studio

# =============================================================================
# LOCAL ONLY — never deployed to Vercel, never committed.
# Used by deploy scripts (forge) and the admin CLI (mint-song-name.mjs) only.
# Prefer a forge keystore over a raw key where possible.
#
# NOTE for forge: it runs from contracts/ and reads env from THERE, not this repo-root file. Before
# deploying: `cd contracts && ln -sf ../.env .env` (gitignored) so ${BASE_RPC_URL}, USDC_ADDRESS,
# TREASURY_ADDRESS, and ETHERSCAN_API_KEY resolve. Sign with a keystore — `cast wallet import
# tortoise-admin --interactive`, then `--account tortoise-admin --sender <addr>` — rather than putting
# ADMIN_PRIVATE_KEY in your shell. (forge needs an explicit signer; --broadcast alone won't sign.)
# =============================================================================
ADMIN_PRIVATE_KEY=
# For `forge verify-contract` on Basescan after deploy.
ETHERSCAN_API_KEY=
