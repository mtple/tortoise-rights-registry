# =============================================================================
# Tortoise Rights Registry — environment template
# Copy to `.env` (gitignored) and fill in. NEVER commit real values.
# =============================================================================

# ----- RPC -----
# Base mainnet (chainId 8453). Public endpoint works; swap for a private one if rate-limited.
NEXT_PUBLIC_RPC_URL=https://mainnet.base.org
BASE_RPC_URL=https://mainnet.base.org
# Ethereum L1 (only needed for ENS resolver setup / reads)
L1_RPC_URL=https://ethereum-rpc.publicnode.com

# ----- Walrus (TESTNET for blobs — see README "Walrus" note) -----
# Mainnet has no free publisher; we use the free open testnet publisher for audio + manifests.
# Reads use the matching testnet aggregator. (Verified working 2026-06.)
WALRUS_PUBLISHER=https://publisher.walrus-testnet.walrus.space
WALRUS_AGGREGATOR=https://aggregator.walrus-testnet.walrus.space
# Optional: auth header value if you switch to an authed/own publisher (e.g. "Bearer xxx"). Leave blank for testnet.
WALRUS_PUBLISHER_AUTH=
# Default storage duration (testnet epoch ~1 day; mainnet ~14 days). 6 epochs per plan D7.
WALRUS_EPOCHS=6

# ----- Onchain addresses (Base mainnet) -----
# USDC — VERIFIED decimals()=6 on Base mainnet.
USDC_ADDRESS=0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913
# Filled after each deploy step (see PREREQUISITES.md):
RIGHTS_REGISTRY_ADDRESS=
TORTOISE_REGISTRAR_ADDRESS=
L2_REGISTRY_ADDRESS=
# Optional: the block the registry was deployed at. Lets verify-song-license.mjs --buyer scan
# LicensePurchased events from there (public RPCs cap eth_getLogs to ~10k blocks).
REGISTRY_DEPLOY_BLOCK=
# Treasury that receives USDC license payments (constructor arg — triple-check before deploy, C9).
TREASURY_ADDRESS=

# ----- ENS -----
ENS_PARENT=tortmusic.eth
# Durin L1 resolver (Ethereum mainnet) + L2RegistryFactory (Base) — same across chains.
DURIN_L1_RESOLVER=0x8A968aB9eb8C084FBC44c531058Fc9ef945c3D61
DURIN_L2_FACTORY=0xDddddDdDDD8Aa1f237b4fa0669cb46892346d22d
# CCIP-Read gateway hostname reported by the durin.dev deploy flow (fill after L2Registry deploy).
DURIN_CCIP_GATEWAY=

# ----- Tortoise public read seam (D9) -----
TORTOISE_API_BASE=https://tortoise.studio

# =============================================================================
# LOCAL ONLY — never deployed to Vercel, never committed.
# Used by deploy scripts (forge) and the admin CLI (mint-song-name.mjs) only.
# Prefer a forge keystore over a raw key where possible.
# =============================================================================
ADMIN_PRIVATE_KEY=
# For `forge verify-contract` on Basescan after deploy.
ETHERSCAN_API_KEY=
