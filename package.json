{
  "name": "tortoise-rights-registry",
  "version": "0.1.0",
  "private": true,
  "description": "AI Training Rights Registry for Tortoise Music — provable artist opt-in, Walrus-stored consent manifests, on-chain USDC licensing, and independent verification.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20",
    "pnpm": ">=10"
  },
  "packageManager": "pnpm@10.30.0",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "abi": "node scripts/extract-abi.mjs",
    "smoke:walrus": "node scripts/smoke-walrus.mjs",
    "smoke:ens": "node scripts/smoke-ens.mjs",
    "smoke:arc": "node scripts/smoke-arc.mjs",
    "verify": "node scripts/verify-song-license.mjs",
    "mint:name": "node scripts/mint-song-name.mjs"
  },
  "dependencies": {
    "@coinbase/wallet-sdk": "^4.3.7",
    "@tanstack/react-query": "^5.101.0",
    "next": "16.2.9",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "viem": "^2.52.2",
    "wagmi": "^2.16.4",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.0",
    "vitest": "^2.1.0"
  }
}
